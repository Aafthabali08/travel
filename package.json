{
  "name": "routewise",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "npm run test:api && npm run test:unit && npm run test:rules",
    "test:api": ".venv/bin/python -m pytest backend/tests -q",
    "test:unit": "vitest run --project unit",
    "test:rules": "firebase emulators:exec --project demo-routewise --only firestore \"vitest run --project rules\"",
    "test:e2e": "firebase emulators:exec --project demo-routewise --only auth,firestore \"playwright test\"",
    "test:all": "npm test && npm run test:e2e",
    "test:live": ".venv/bin/python scripts/check_live.py"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "source-map-js": "^1.2.2"
  }
}
