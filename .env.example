GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
# Optional: Gemini fare suggestions shown beside RouteWise's fare (key from https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Leave blank to use the current Flash models; a model Google can't find is skipped automatically.
GEMINI_MODEL=
# Firebase Authentication (web app config from Firebase console → Project settings → Your apps).
# These are public browser keys; they're baked into the frontend at build time.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Backend: when set, route/place/navigation APIs require a Firebase ID token (same value as VITE_FIREBASE_PROJECT_ID).
FIREBASE_PROJECT_ID=
DATABASE_URL=postgresql+psycopg://routewise:routewise@localhost:5432/routewise
LOG_LEVEL=INFO
